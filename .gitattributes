###############################################################################
# Git LFS
###############################################################################

# The PDF files of the upstream documentation, until that documentation is removed. No build or test reads them
*.pdf      filter=lfs diff=lfs merge=lfs -text

###############################################################################
# Text normalization
###############################################################################

* text=auto

*.c        text
*.cpp      text
*.h        text
*.hpp      text
*.cmake    text
CMakeLists.txt text

*.py       text
*.cs       text
*.java     text
*.js       text
*.ts       text
*.html     text
*.css      text
*.xml      text
*.json     text
*.yaml     text
*.yml      text
*.toml     text
*.ini      text
*.md       text

###############################################################################
# Windows scripts
###############################################################################

*.bat      text eol=crlf
*.cmd      text eol=crlf

###############################################################################
# Unix scripts
###############################################################################

*.sh       text eol=lf

###############################################################################
# Binary data
###############################################################################

# The raw images of the tests are never converted. This section stays after `* text=auto`: the last matching line wins
*.raw      binary
