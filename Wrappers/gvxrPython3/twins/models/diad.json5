{
    // Name of the system, can include spaces
    "name": "DIAD",

    // Description of the system, mention the source, detector, affiliations,
    // etc
    "description": "K11 DIAD: Dual Imaging and Diffraction\nThe DIAD beamline is dual beam X-ray instrument for imaging, diffraction and scattering, which operates at energies of 7-38 keV.\nThe primary aim of the beamline is to provide a tool to investigate:\n- The internal 2D- and 3D-microstructure of complex, dynamic structures (with imaging)\n- Local phase and/or strain information (from diffraction)\n- On the micron scale\n- Within the same specimen, at the same location\n- Quasi-simultaneously\n- During in-operando / in-situ conditions",

    // Name of the facility, can include spaces
    "facility": "Diamond Light Source",

    // Date of data collection used to create the digital twin.
    "date": "",

    // Any affiliations related to the digital twin and machine, e.g facility,
    // manufacturer, funding partner, lab of the researcher, etc
    "affilliates": {
        "Diamond Light Source": {
            "website": "https://www.diamond.ac.uk/Home.html"
        }
    },

    "beams": {
        "monochromatic": {
            "beam_type": "monochromatic",
            "shape": "parallel",

            "keV": [14.01, 37.92],

            // Source flux determination for representative noise Note: This takes
            // into account end-to-end effects, not just raw flux from tube.
            //
            // Optional, leave curve, x, and y as [] if empty.
            "flux": {
                // Coefficients for [keV] to calculate photonic flux per at 1 [s].
                "curve": [],

                // 1-D array of monotonically increasing real values.
//                x: [14.01, 22.0, 37.92],
                x: [14.01, 18.03, 22.0, 36.0, 37.92],

                // Array of real values.
                // with LSF
                y: [106479377644286,
                    110164778264802,
                    31223331936275.3,
                    17696381885324.9,
                    5640081031912.1
                ],

                // without LSF
//                y: [1475348935072906.2, 1367818329264162.0, 443676194470841.6, 179810706599136.56, 61455881451181.234],

                // Interpolation method.
                //
                // Optional, leave as "" if empty. Supported values are:
                // "CubicSpline", "PchipInterpolator", "Akima1DInterpolator", "Makima1DInterpolator",
                // "FloaterHormannInterpolator", "BarycentricInterpolator", "KroghInterpolator"
                // "SmoothingSpline"
                interpolator: "Akima1DInterpolator",

                // Correction factors for flux estimation from experimental validation.
                //
                // Optional, leave as {} if empty.
                "correction": {}
            }
        },

