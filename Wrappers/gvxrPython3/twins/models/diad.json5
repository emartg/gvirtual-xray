        // Detector gain to convert 0.0 - 1.0 to 0 - 65536.
        //
        // gain = 1 / (k * adu)
        // image = gain * image
        //
        // k is an experimentally derived gain-independent detector multiplicative
        // factor. ADU is obtained from detector documentation, and used during the
        // derivation of k.
        //
        // In cases where ADU is unknown, the product of gain may be used.
        //
        // Optional, if k is defined, ADU will be used.
        // if k and ADU are undefined, gains will be used.
        //
        // Set gains to [1] to disable detector gain simulation and keep images in
        // floating-point format. This will disable overexposure capability.
        "gain": {
            // Gain multipliers, only used if k or ADU are not defined.
            // Defining 'gains' with 'k' or 'adus' will cause an error.
            // with LSF
            "gains": [2206.99094441843]

            // without LSF
//            "gains": [151.35198560893645]
        },

        "darkfield": {
            // Residual darkfield current bias added to all images
            // image = image + bias
            // The average value of darkfield is bias, and standard deviation sigma

            // Optional, leave 0 to disable, or gain is not set.
            "bias": 96.95039,

            // Optional, leave 0 to disable, or sigma is not set.
            "sigma": 3.0236413
        }
    },

    // Source and detector positioning
    "stage": {
        // If true, The detector will be fixed at the source's maximum distance
        // away from the detector, with the sample moving between [minimum,
        // maximum] E.g, setting source to [10, 120] will ensure SDD is always
        // 120mm, and allow SOD between 10mm to 120mm.
        "static_sdd": false,

        // [minimum, maximum] Distance source can move towards or away from the
        // sample in [mm]
        //
        // Optional, set to [] if unconstrained, or [0, 0] if fixed.
        "source": {
            // Left-right movement
            "x": [],
            // forward-backwards movement
            "y": [47500, 47500],
            // up-down movement
            "z": []
        },

        // [minimum, maximum] Distance detector can move towards or away from
        // the sample in [mm]
        //
        // Optional, set to [] if unconstrained, or [0, 0] if fixed.
        "detector": {
            // Left-right movement
            "x": [],
            // forward-backwards movement
            // 1.25 mm to 1.37 m
            // 300 mm is the max in practice
            "y": [1.25, 1370, 300],
            // up-down movement
            "z": []
        }
    }
}
